---
// The phone outline used by the hero and by every module recording. The slot fills the screen.
interface Props {
  float?: boolean;
}
const { float = false } = Astro.props;
---

<div class:list={['phone-frame', { 'phone-frame--float': float }]}>
  <div class="phone-frame__screen">
    <slot />
  </div>
</div>

<style>
  .phone-frame {
    /* The screen keeps the 390:684 shape the recordings are made in. */
    --phone-w: 280px;
    width: var(--phone-w);
    max-width: 100%;
    aspect-ratio: 280 / 476;
    flex-shrink: 0;
    background: var(--color-text);
    border-radius: 40px;
    padding: 10px;
    box-shadow:
      0 30px 60px -10px rgba(40, 50, 45, 0.18),
      0 10px 20px rgba(0, 0, 0, 0.06);
    position: relative;
    overflow: hidden;
  }
  .phone-frame--float {
    animation: phone-float 6s ease-in-out infinite;
  }
  @keyframes phone-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }
  .phone-frame__screen {
    width: 100%;
    height: 100%;
    border-radius: 30px;
    overflow: hidden;
    background: var(--color-canvas);
  }
  .phone-frame__screen :global(img),
  .phone-frame__screen :global(video) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
  }
  @media (prefers-reduced-motion: reduce) {
    .phone-frame--float { animation: none; }
  }
</style>
