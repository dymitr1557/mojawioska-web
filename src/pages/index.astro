---
import Layout from '../layouts/Layout.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
---

<Layout
  title="Moja Wioska"
  description="Moja Wioska — inteligentna aplikacja mobilna dla Twojego domu. Zadania, przepisy, lista zakupów, pogoda i czat — wszystko wspierane przez AI."
  alternatePath=""
  variant="landing"
>
  <!-- NAV -->
  <nav class="nav">
    <div class="nav-inner">
      <a href="/" class="nav-logo">
        <img src="/logo/logo-horizontal.svg" alt="Moja Wioska" width="160" height="40" />
      </a>
      <div class="nav-actions">
        <a href="#funkcje" class="nav-link">Funkcje</a>
        <a href="#ai" class="nav-link">AI</a>
        <a href={getRelativeLocaleUrl('en', '')} class="lang-btn" hreflang="en">EN</a>
        <a href="#pobierz" class="nav-cta">Pobierz</a>
      </div>
    </div>
  </nav>

  <!-- HERO -->
  <section class="hero">
    <div class="hero-bg">
      <div class="blob blob-1"></div>
      <div class="blob blob-2"></div>
      <div class="blob blob-3"></div>
      <div class="dot-grid"></div>
    </div>
    <div class="hero-inner">
      <div class="hero-content">
        <div class="hero-badge">
          <span class="badge-dot"></span>
          Wspierana przez AI
        </div>
        <h1>Twoja wioska<br/>w&nbsp;<span class="gradient-text">kieszeni</span></h1>
        <p class="hero-desc">
          Moja Wioska to inteligentna aplikacja mobilna, która pomaga zarządzać codziennością
          Twojego domu. Zadania, przepisy, lista zakupów, pogoda, czat i&nbsp;wiele więcej
          — wszystko w&nbsp;jednym miejscu.
        </p>
        <div class="hero-actions">
          <a href="#pobierz" class="btn btn-primary">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M3.609 1.814L13.792 12 3.61 22.186a.996.996 0 0 1-.61-.92V2.734a1 1 0 0 1 .609-.92zm10.89 10.893l2.302 2.302-10.937 6.333 8.635-8.635zm3.199-3.199l2.302 2.302a1 1 0 0 1 0 1.38l-2.302 2.302L15.202 12l2.496-2.492zM5.864 3.465L16.8 9.798l-2.302 2.302-8.635-8.635z"/></svg>
            Pobierz na Android
          </a>
          <a href="#funkcje" class="btn btn-ghost">
            Poznaj funkcje
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
          </a>
        </div>
      </div>
      <div class="hero-visual">
        <div class="phone-mockup">
          <div class="phone-notch"></div>
          <div class="phone-screen">
            <img src="/logo/mark.svg" alt="Moja Wioska" class="phone-logo" width="200" height="200" />
            <div class="phone-modules">
              <div class="pm" style="--c:#567866">Zadania</div>
              <div class="pm" style="--c:#97B6D4">Pogoda</div>
              <div class="pm" style="--c:#C76B4F">Czat</div>
              <div class="pm" style="--c:#E2B25F">Przepisy</div>
            </div>
          </div>
        </div>
        <div class="floating-pills">
          <div class="pill pill-1">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#567866" stroke-width="2"><path d="M9 11l3 3L22 4"/></svg>
            Rozpoznaje daty
          </div>
          <div class="pill pill-2">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#E2B25F" stroke-width="2"><path d="M15 11h.01M11 15h.01M16 16h.01M2 16l20 6-6-20A20 20 0 0 0 2 16"/></svg>
            Generuje przepisy
          </div>
          <div class="pill pill-3">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#97B6D4" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41"/></svg>
            Dobiera strój
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- STATS STRIP -->
  <section class="stats">
    <div class="stats-inner">
      <div class="stat">
        <span class="stat-num">8</span>
        <span class="stat-label">inteligentnych modułów</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat">
        <span class="stat-num">6</span>
        <span class="stat-label">funkcji AI</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat">
        <span class="stat-num">2</span>
        <span class="stat-label">wersje językowe</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat">
        <span class="stat-num">&infin;</span>
        <span class="stat-label">tematów quizów</span>
      </div>
    </div>
  </section>

  <!-- FEATURES -->
  <section class="features" id="funkcje">
    <div class="section-inner">
      <div class="section-label">Funkcje</div>
      <h2>Wszystko, czego potrzebuje Twój dom</h2>
      <p class="section-desc">
        Osiem inteligentnych modułów, które dostosowują się do Twojego stylu życia.
      </p>
      <div class="features-grid">
        <div class="feature-card" style="--card-accent: #567866; --card-bg: rgba(201,235,208,0.35)">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="var(--card-accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
          </div>
          <h3>Zadania</h3>
          <p>AI rozpoznaje daty, adresy, numery telefonów i&nbsp;linki w&nbsp;Twoich zadaniach — wystarczy jedno kliknięcie, by zadzwonić, dodać do kalendarza albo otworzyć mapę.</p>
        </div>
        <div class="feature-card" style="--card-accent: #97B6D4; --card-bg: #eff5fa">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="var(--card-accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/><circle cx="12" cy="12" r="4"/></svg>
          </div>
          <h3>Pogoda i&nbsp;ubiór</h3>
          <p>Sprawdź pogodę i&nbsp;dowiedz się, co dziś założyć. Algorytm uczy się Twoich preferencji z&nbsp;każdą oceną, dopasowując strój do Twojego odczucia temperatury.</p>
        </div>
        <div class="feature-card" style="--card-accent: #C76B4F; --card-bg: #fbf0eb">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="var(--card-accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          </div>
          <h3>Czat wioskowy</h3>
          <p>Komunikacja w&nbsp;czasie rzeczywistym. Twórz grupy prywatne i&nbsp;publiczne dla rodziny, sąsiadów czy znajomych. Zaznacz tekst i&nbsp;zapisz go do notatek jednym kliknięciem.</p>
        </div>
        <div class="feature-card" style="--card-accent: #E2B25F; --card-bg: #fcf4e2">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="var(--card-accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 11h.01"/><path d="M11 15h.01"/><path d="M16 16h.01"/><path d="m2 16 20 6-6-20A20 20 0 0 0 2 16"/><path d="M5.71 17.11a17.04 17.04 0 0 1 11.4-11.4"/></svg>
          </div>
          <h3>Przepisy</h3>
          <p>Wklej link, wpisz przepis lub poproś AI — aplikacja sama sformatuje składniki, porcje i&nbsp;kroki przygotowania. Zaimportuj przepis ze zdjęcia lub pliku PDF.</p>
        </div>
        <div class="feature-card" style="--card-accent: #8FAC94; --card-bg: rgba(201,235,208,0.25)">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="var(--card-accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
          </div>
          <h3>Lista zakupów</h3>
          <p>Dodawaj produkty tekstem, zdjęciem lub plikiem. Automatyczna kategoryzacja ułatwia robienie zakupów. Udostępnij listę domownikom jednym kliknięciem.</p>
        </div>
        <div class="feature-card" style="--card-accent: #7D5C78; --card-bg: #f6eef2">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="var(--card-accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          </div>
          <h3>Quiz AI</h3>
          <p>Podaj dowolny temat — AI przygotuje quiz edukacyjny z&nbsp;pytaniami i&nbsp;odpowiedziami. Idealne do nauki, zabawy z&nbsp;dziećmi i&nbsp;testowania wiedzy.</p>
        </div>
        <div class="feature-card" style="--card-accent: #627A6B; --card-bg: rgba(98,122,107,0.08)">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="var(--card-accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
          </div>
          <h3>Notatnik</h3>
          <p>Bogaty edytor tekstu z&nbsp;hierarchią stron i&nbsp;podstron. Formatuj tekst, dodawaj linki i&nbsp;listy. Importuj notatki ze zdjęć i&nbsp;plików PDF.</p>
        </div>
        <div class="feature-card" style="--card-accent: #97472e; --card-bg: #fbf0eb">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="var(--card-accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </div>
          <h3>Timer</h3>
          <p>Trzy wizualne tryby: odliczanie, klepsydra piaskowa i&nbsp;timer wodny. Ustaw czas od 15&nbsp;sekund do 2&nbsp;godzin z&nbsp;powiadomieniem na koniec.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- AI SECTION -->
  <section class="ai-section" id="ai">
    <div class="section-inner">
      <div class="section-label">Sztuczna inteligencja</div>
      <h2>AI, który rozumie Twoje potrzeby</h2>
      <p class="section-desc">
        Moja Wioska wykorzystuje sztuczną inteligencję, aby automatyzować codzienne czynności
        i&nbsp;oszczędzać Twój czas.
      </p>
      <div class="ai-grid">
        <div class="ai-item">
          <div class="ai-icon-wrap" style="--ai-c: #567866"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg></div>
          <div class="ai-text">
            <h3>Import dokumentów</h3>
            <p>Zrób zdjęcie paragonu, przepisu lub listy zadań — AI odczyta treść i&nbsp;doda ją do odpowiedniego modułu. Obsługuje zdjęcia i&nbsp;pliki PDF.</p>
          </div>
        </div>
        <div class="ai-item">
          <div class="ai-icon-wrap" style="--ai-c: #C76B4F"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg></div>
          <div class="ai-text">
            <h3>Rozpoznawanie encji</h3>
            <p>AI automatycznie wykrywa w&nbsp;zadaniach numery telefonów, daty, adresy, linki, e-maile i&nbsp;numery kont bankowych, dając szybki dostęp do akcji.</p>
          </div>
        </div>
        <div class="ai-item">
          <div class="ai-icon-wrap" style="--ai-c: #E2B25F"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 11h.01M11 15h.01M16 16h.01M2 16l20 6-6-20A20 20 0 0 0 2 16"/></svg></div>
          <div class="ai-text">
            <h3>Generowanie przepisów</h3>
            <p>Poproś o&nbsp;danie, wklej link albo tekst — AI sformatuje przepis z&nbsp;pełną listą składników, porcjami i&nbsp;krokami przygotowania.</p>
          </div>
        </div>
        <div class="ai-item">
          <div class="ai-icon-wrap" style="--ai-c: #97B6D4"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2"/><circle cx="12" cy="12" r="4"/></svg></div>
          <div class="ai-text">
            <h3>Algorytm ubierania</h3>
            <p>Na podstawie pogody, płci i&nbsp;Twojego feedbacku AI proponuje kompletny strój. Z&nbsp;każdą oceną dopasowanie staje się lepsze.</p>
          </div>
        </div>
        <div class="ai-item">
          <div class="ai-icon-wrap" style="--ai-c: #7D5C78"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg></div>
          <div class="ai-text">
            <h3>Quizy edukacyjne</h3>
            <p>AI generuje quizy na dowolny temat — od szkolnych przedmiotów po radzenie sobie ze stresem. Określ liczbę pytań i&nbsp;graj.</p>
          </div>
        </div>
        <div class="ai-item">
          <div class="ai-icon-wrap" style="--ai-c: #8FAC94"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg></div>
          <div class="ai-text">
            <h3>Inteligentna lista zakupów</h3>
            <p>Dodaj produkty ze zdjęcia paragonu lub pliku — AI rozpozna pozycje, skategoryzuje je i&nbsp;doda do listy automatycznie.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- DOWNLOAD -->
  <section class="download" id="pobierz">
    <div class="download-bg">
      <div class="download-blob download-blob-1"></div>
      <div class="download-blob download-blob-2"></div>
    </div>
    <div class="section-inner download-inner">
      <img src="/logo/mark.svg" alt="" class="download-mark" width="96" height="96" />
      <h2>Pobierz Moja Wioska</h2>
      <p class="section-desc">
        Dołącz do społeczności i&nbsp;zarządzaj codziennością swojego domu w&nbsp;jednej aplikacji.
      </p>
      <div class="download-actions">
        <a href="https://play.google.com/store/apps/details?id=pl.moja_wioska" target="_blank" rel="noopener" class="btn btn-primary btn-lg">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M3.609 1.814L13.792 12 3.61 22.186a.996.996 0 0 1-.61-.92V2.734a1 1 0 0 1 .609-.92zm10.89 10.893l2.302 2.302-10.937 6.333 8.635-8.635zm3.199-3.199l2.302 2.302a1 1 0 0 1 0 1.38l-2.302 2.302L15.202 12l2.496-2.492zM5.864 3.465L16.8 9.798l-2.302 2.302-8.635-8.635z"/></svg>
          Google Play
        </a>
      </div>
      <p class="download-note">Android 8.0+ &middot; Darmowa &middot; Polski i angielski</p>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="landing-footer">
    <div class="footer-content">
      <div class="footer-top">
        <img src="/logo/logo-horizontal.svg" alt="Moja Wioska" width="140" height="35" class="footer-logo" />
        <div class="footer-nav">
          <a href={getRelativeLocaleUrl('pl', 'regulamin')}>Regulamin</a>
          <a href={getRelativeLocaleUrl('pl', 'polityka-prywatnosci')}>Polityka prywatności</a>
          <a href={getRelativeLocaleUrl('pl', 'polityka-cookies')}>Polityka cookies</a>
        </div>
      </div>
      <div class="footer-bottom">
        <p>&copy; {new Date().getFullYear()} Moja Wioska. Wszelkie prawa zastrzeżone.</p>
        <a href={getRelativeLocaleUrl('en', '')} hreflang="en" class="footer-lang">English version</a>
      </div>
    </div>
  </footer>
</Layout>

<style>
  /* NAV */
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(250, 247, 242, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border);
  }
  .nav-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 14px var(--gutter);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .nav-logo img { height: 36px; width: auto; }
  .nav-actions { display: flex; align-items: center; gap: 8px; }
  .nav-link {
    display: none;
    padding: 8px 14px;
    font-size: 14px;
    font-weight: 500;
    color: var(--color-text-muted);
    transition: color 0.2s;
  }
  .nav-link:hover { color: var(--color-text); }
  @media (min-width: 768px) {
    .nav-link { display: inline-flex; }
    .nav-actions { gap: 6px; }
  }
  .lang-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: var(--radius-full);
    background: var(--color-surface-soft);
    font-size: 13px;
    font-weight: 600;
    color: var(--color-text-muted);
    transition: background 0.2s;
  }
  .lang-btn:hover { background: var(--color-border); color: var(--color-text); }
  .nav-cta {
    display: inline-flex;
    align-items: center;
    padding: 8px 20px;
    border-radius: var(--radius-full);
    background: var(--color-primary);
    color: var(--color-on-primary);
    font-size: 14px;
    font-weight: 600;
    transition: background 0.2s, box-shadow 0.2s;
  }
  .nav-cta:hover {
    background: var(--color-primary-hover);
    color: var(--color-on-primary);
    box-shadow: var(--shadow-button);
  }

  /* BUTTONS */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 28px;
    border-radius: var(--radius-full);
    font-size: 15px;
    font-weight: 600;
    font-family: var(--font);
    text-decoration: none;
    transition: background 0.2s, box-shadow 0.2s, transform 0.15s;
    cursor: pointer;
    border: none;
  }
  .btn:active { transform: scale(0.97); }
  .btn-primary {
    background: var(--color-primary);
    color: var(--color-on-primary);
    box-shadow: var(--shadow-button);
  }
  .btn-primary:hover {
    background: var(--color-primary-hover);
    color: var(--color-on-primary);
  }
  .btn-ghost {
    background: transparent;
    color: var(--color-text-muted);
    border: 1.5px solid var(--color-border);
  }
  .btn-ghost:hover {
    background: var(--color-surface-soft);
    color: var(--color-text);
    border-color: var(--color-text-subtle);
  }
  .btn-lg { padding: 16px 36px; font-size: 16px; }

  /* HERO */
  .hero {
    position: relative;
    padding: 60px var(--gutter) 40px;
    overflow: hidden;
    min-height: 600px;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }
  .blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.5;
  }
  .blob-1 {
    width: 500px; height: 500px;
    background: radial-gradient(circle, rgba(201,235,208,0.7), transparent 70%);
    top: -100px; right: -80px;
    animation: drift1 12s ease-in-out infinite;
  }
  .blob-2 {
    width: 400px; height: 400px;
    background: radial-gradient(circle, rgba(151,178,212,0.4), transparent 70%);
    bottom: -50px; left: -100px;
    animation: drift2 14s ease-in-out infinite;
  }
  .blob-3 {
    width: 300px; height: 300px;
    background: radial-gradient(circle, rgba(226,178,95,0.3), transparent 70%);
