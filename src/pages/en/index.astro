---
import Layout from '../../layouts/Layout.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
---

<Layout
  title="Moja Wioska"
  description="Moja Wioska — an AI-powered mobile app for your household. Tasks, recipes, shopping list, weather and chat — all in one place."
  alternatePath=""
  variant="landing"
>
  <!-- NAV -->
  <nav class="nav">
    <div class="nav-inner">
      <a href={getRelativeLocaleUrl('en', '')} class="nav-logo">
        <img src="/logo/logo-horizontal.svg" alt="Moja Wioska" width="160" height="40" />
      </a>
      <div class="nav-actions">
        <a href={getRelativeLocaleUrl('pl', '')} class="lang-btn" hreflang="pl">PL</a>
        <a href="#download" class="nav-cta">Download</a>
      </div>
    </div>
  </nav>

  <!-- HERO -->
  <section class="hero">
    <div class="hero-inner">
      <div class="hero-badge">Powered by AI</div>
      <h1>Your village in&nbsp;your pocket</h1>
      <p class="hero-desc">
        Moja Wioska is a smart mobile app that helps you manage your household's daily life.
        Tasks, recipes, shopping lists, weather, chat and more — all in one place,
        powered by artificial intelligence.
      </p>
      <div class="hero-actions">
        <a href="#download" class="btn btn-primary">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          Download for Android
        </a>
      </div>
      <div class="hero-visual">
        <img src="/logo/mark.svg" alt="" class="hero-mark" width="280" height="280" />
      </div>
    </div>
  </section>

  <!-- FEATURES -->
  <section class="features" id="features">
    <div class="section-inner">
      <div class="section-label">Features</div>
      <h2>Everything your household needs</h2>
      <p class="section-desc">
        Eight smart modules that adapt to your lifestyle.
      </p>
      <div class="features-grid">
        <div class="feature-card" style="--card-accent: #567866; --card-bg: rgba(201,235,208,0.35)">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="var(--card-accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
          </div>
          <h3>Tasks</h3>
          <p>AI recognises dates, addresses, phone numbers and links in your tasks — one tap to call, add to calendar or open in maps.</p>
        </div>
        <div class="feature-card" style="--card-accent: #97B6D4; --card-bg: #eff5fa">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="var(--card-accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/><circle cx="12" cy="12" r="4"/></svg>
          </div>
          <h3>Weather &amp; outfit</h3>
          <p>Check the weather and find out what to wear today. The algorithm learns your preferences with every rating, matching outfits to how you feel.</p>
        </div>
        <div class="feature-card" style="--card-accent: #C76B4F; --card-bg: #fbf0eb">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="var(--card-accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          </div>
          <h3>Village chat</h3>
          <p>Real-time messaging. Create private and public groups for family, neighbours or friends. Select text and save it to your notebook with one tap.</p>
        </div>
        <div class="feature-card" style="--card-accent: #E2B25F; --card-bg: #fcf4e2">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="var(--card-accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 11h.01"/><path d="M11 15h.01"/><path d="M16 16h.01"/><path d="m2 16 20 6-6-20A20 20 0 0 0 2 16"/><path d="M5.71 17.11a17.04 17.04 0 0 1 11.4-11.4"/></svg>
          </div>
          <h3>Recipes</h3>
          <p>Paste a link, type a recipe or ask AI — the app formats ingredients, portions and steps automatically. Import recipes from photos or PDF files.</p>
        </div>
        <div class="feature-card" style="--card-accent: #8FAC94; --card-bg: rgba(201,235,208,0.25)">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="var(--card-accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
          </div>
          <h3>Shopping list</h3>
          <p>Add products by text, photo or file. Auto-categorisation makes shopping easier. Share the list with your household in one tap.</p>
        </div>
        <div class="feature-card" style="--card-accent: #7D5C78; --card-bg: #f6eef2">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="var(--card-accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          </div>
          <h3>AI Quiz</h3>
          <p>Pick any topic — AI generates an educational quiz with questions and answers. Perfect for learning, playing with kids and testing knowledge.</p>
        </div>
        <div class="feature-card" style="--card-accent: #627A6B; --card-bg: rgba(98,122,107,0.08)">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="var(--card-accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
          </div>
          <h3>Notebook</h3>
          <p>Rich text editor with hierarchical pages and sub-pages. Format text, add links and lists. Import notes from photos and PDF files.</p>
        </div>
        <div class="feature-card" style="--card-accent: #97472e; --card-bg: #fbf0eb">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="var(--card-accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </div>
          <h3>Timer</h3>
          <p>Three visual modes: countdown, sand timer and water timer. Set any duration from 15 seconds to 2 hours with an alert at the end.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- AI SECTION -->
  <section class="ai-section">
    <div class="section-inner">
      <div class="section-label">Artificial intelligence</div>
      <h2>AI that understands your needs</h2>
      <p class="section-desc">
        Moja Wioska uses artificial intelligence to automate daily tasks
        and save your time.
      </p>
      <div class="ai-grid">
        <div class="ai-item">
          <div class="ai-num">01</div>
          <h3>Document import</h3>
          <p>Take a photo of a receipt, recipe or task list — AI reads the content and adds it to the right module. Supports photos and PDF files.</p>
        </div>
        <div class="ai-item">
          <div class="ai-num">02</div>
          <h3>Entity recognition</h3>
          <p>AI automatically detects phone numbers, dates, addresses, links, emails and bank account numbers in your tasks, giving you quick access to actions.</p>
        </div>
        <div class="ai-item">
          <div class="ai-num">03</div>
          <h3>Recipe generation</h3>
          <p>Ask for a dish, paste a link or text — AI formats the recipe with a full ingredient list, portions and step-by-step instructions.</p>
        </div>
        <div class="ai-item">
          <div class="ai-num">04</div>
          <h3>Outfit algorithm</h3>
          <p>Based on the weather, gender and your feedback, AI suggests a complete outfit. Every rating makes the match more accurate.</p>
        </div>
        <div class="ai-item">
          <div class="ai-num">05</div>
          <h3>Educational quizzes</h3>
          <p>AI generates quizzes on any topic — from school subjects to stress management. Set the number of questions and play.</p>
        </div>
        <div class="ai-item">
          <div class="ai-num">06</div>
          <h3>Smart shopping list</h3>
          <p>Add products from a receipt photo or file — AI recognises the items, categorises them and adds them to the list automatically.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- DOWNLOAD -->
  <section class="download" id="download">
    <div class="section-inner download-inner">
      <img src="/logo/mark.svg" alt="" class="download-mark" width="96" height="96" />
      <h2>Download Moja Wioska</h2>
      <p class="section-desc">
        Join the community and manage your household's daily life in one app.
      </p>
      <div class="download-actions">
        <a href="https://play.google.com/store/apps/details?id=pl.moja_wioska" target="_blank" rel="noopener" class="btn btn-primary btn-lg">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M3.609 1.814L13.792 12 3.61 22.186a.996.996 0 0 1-.61-.92V2.734a1 1 0 0 1 .609-.92zm10.89 10.893l2.302 2.302-10.937 6.333 8.635-8.635zm3.199-3.199l2.302 2.302a1 1 0 0 1 0 1.38l-2.302 2.302L15.202 12l2.496-2.492zM5.864 3.465L16.8 9.798l-2.302 2.302-8.635-8.635z"/></svg>
          Google Play
        </a>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="landing-footer">
    <div class="footer-content">
      <div class="footer-top">
        <img src="/logo/logo-horizontal.svg" alt="Moja Wioska" width="140" height="35" class="footer-logo" />
        <div class="footer-nav">
          <a href={getRelativeLocaleUrl('en', 'terms')}>Terms of Service</a>
          <a href={getRelativeLocaleUrl('en', 'privacy')}>Privacy Policy</a>
          <a href={getRelativeLocaleUrl('en', 'cookies')}>Cookie Policy</a>
        </div>
      </div>
      <div class="footer-bottom">
        <p>&copy; {new Date().getFullYear()} Moja Wioska. All rights reserved.</p>
        <a href={getRelativeLocaleUrl('pl', '')} hreflang="pl" class="footer-lang">Wersja polska</a>
      </div>
    </div>
  </footer>
</Layout>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(250, 247, 242, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border);
  }
  .nav-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 14px var(--gutter);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .nav-logo img { height: 36px; width: auto; }
  .nav-actions { display: flex; align-items: center; gap: 12px; }
  .lang-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: var(--radius-full);
    background: var(--color-surface-soft);
    font-size: 13px;
    font-weight: 600;
    color: var(--color-text-muted);
    transition: background 0.2s;
  }
  .lang-btn:hover { background: var(--color-border); color: var(--color-text); }
  .nav-cta {
    display: inline-flex;
    align-items: center;
    padding: 8px 20px;
    border-radius: var(--radius-full);
    background: var(--color-primary);
    color: var(--color-on-primary);
    font-size: 14px;
    font-weight: 600;
    transition: background 0.2s, box-shadow 0.2s;
  }
  .nav-cta:hover {
    background: var(--color-primary-hover);
    color: var(--color-on-primary);
    box-shadow: var(--shadow-button);
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 28px;
    border-radius: var(--radius-full);
    font-size: 15px;
    font-weight: 600;
    font-family: var(--font);
    text-decoration: none;
    transition: background 0.2s, box-shadow 0.2s, transform 0.15s;
    cursor: pointer;
    border: none;
  }
  .btn:active { transform: scale(0.97); }
  .btn-primary {
    background: var(--color-primary);
    color: var(--color-on-primary);
    box-shadow: var(--shadow-button);
  }
  .btn-primary:hover {
    background: var(--color-primary-hover);
    color: var(--color-on-primary);
  }
  .btn-lg { padding: 16px 36px; font-size: 16px; }
  .hero {
    padding: 80px var(--gutter) 60px;
    text-align: center;
    overflow: hidden;
  }
  .hero-inner { max-width: 680px; margin: 0 auto; }
  .hero-badge {
    display: inline-block;
    padding: 6px 16px;
    border-radius: var(--radius-full);
    background: var(--color-primary-soft);
    color: var(--color-primary);
    font-size: 13px;
    font-weight: 600;
    margin-bottom: 24px;
    letter-spacing: 0.02em;
  }
  .hero h1 {
    font-size: clamp(36px, 7vw, 56px);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin-bottom: 20px;
  }
  .hero-desc {
    font-size: 17px;
    line-height: 1.7;
    color: var(--color-text-muted);
    max-width: 560px;
    margin: 0 auto 36px;
  }
  .hero-actions { display: flex; justify-content: center; gap: 16px; flex-wrap: wrap; margin-bottom: 60px; }
  .hero-visual { display: flex; justify-content: center; }
  .hero-mark {
    width: 240px;
    height: 240px;
    filter: drop-shadow(0 20px 40px rgba(86, 120, 102, 0.15));
    animation: float 6s ease-in-out infinite;
  }
  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-12px); }
  }
  .section-inner { max-width: var(--max-width); margin: 0 auto; padding: 0 var(--gutter); }
  .section-label {
    display: inline-block;
    padding: 5px 14px;
    border-radius: var(--radius-full);
    background: var(--color-surface-soft);
    color: var(--color-text-subtle);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 16px;
  }
  .section-inner h2 {
    font-size: clamp(28px, 5vw, 40px);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.015em;
    margin-bottom: 16px;
  }
  .section-desc { font-size: 16px; line-height: 1.7; color: var(--color-text-muted); max-width: 520px; margin-bottom: 48px; }
  .features {
    padding: 80px 0;
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }
  .features-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 20px; }
  .feature-card {
    background: var(--card-bg);
    border-radius: var(--radius-md);
    padding: 28px 24px;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .feature-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-card); }
  .feature-icon { width: 44px; height: 44px; margin-bottom: 16px; }
  .feature-icon svg { width: 100%; height: 100%; }
  .feature-card h3 { font-size: 17px; font-weight: 700; margin-bottom: 8px; }
  .feature-card p { font-size: 14px; line-height: 1.65; color: var(--color-text-muted); }
  .ai-section { padding: 80px 0; }
  .ai-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 32px 40px; }
  .ai-num {
    font-size: 32px;
    font-weight: 800;
    margin-bottom: 8px;
    line-height: 1;
    background: linear-gradient(135deg, var(--color-primary), var(--color-green-light));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .ai-item h3 { font-size: 17px; font-weight: 700; margin-bottom: 8px; }
  .ai-item p { font-size: 14px; line-height: 1.65; color: var(--color-text-muted); }
  .download {
    padding: 80px 0;
    background: var(--color-primary);
    color: var(--color-on-primary);
    text-align: center;
  }
  .download-inner { display: flex; flex-direction: column; align-items: center; }
  .download-mark {
    width: 80px;
    height: 80px;
    margin-bottom: 24px;
    filter: brightness(0) invert(1) opacity(0.9);
  }
  .download h2 { color: var(--color-on-primary); margin-bottom: 12px; }
  .download .section-desc { color: rgba(255, 255, 255, 0.8); margin-bottom: 36px; }
  .download-actions { display: flex; gap: 16px; flex-wrap: wrap; justify-content: center; }
  .download .btn-primary {
    background: var(--color-on-primary);
    color: var(--color-primary);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.15);
  }
  .download .btn-primary:hover { background: var(--color-canvas); color: var(--color-primary-hover); }
  .landing-footer { padding: 40px var(--gutter) 32px; border-top: 1px solid var(--color-border); }
  .footer-content { max-width: var(--max-width); margin: 0 auto; }
  .footer-top { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 20px; margin-bottom: 24px; }
  .footer-logo { height: 32px; width: auto; }
  .footer-nav { display: flex; gap: 24px; flex-wrap: wrap; }
  .footer-nav a { font-size: 14px; color: var(--color-text-muted); }
  .footer-nav a:hover { color: var(--color-primary); }
  .footer-bottom { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; padding-top: 20px; border-top: 1px solid var(--color-border); }
  .footer-bottom p { font-size: 13px; color: var(--color-text-subtle); }
  .footer-lang { font-size: 13px; color: var(--color-text-muted); }
  @media (max-width: 640px) {
    .hero { padding: 48px var(--gutter) 40px; }
    .hero-mark { width: 180px; height: 180px; }
    .features, .ai-section, .download { padding: 56px 0; }
    .footer-top, .footer-bottom { flex-direction: column; align-items: flex-start; }
    .download { padding: 56px var(--gutter); }
  }
</style>
